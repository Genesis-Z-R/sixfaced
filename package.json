{
  "name": "sixfaced",
  "version": "1.0.0",
  "description": "Sixfaced Desktop App",
  "author": {
    "name": "Genesis-Z-R",
    "email": "ansahdonkorramseyowusu@gmail.com"
  },
  "license": "GPL-3.0",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "start": "vite build && electron .",
    "test": "node --test",
    "dist": "cross-env ELECTRON_DIST=1 vite build && npm run dist:linux && npm run dist:win && npm run dist:mac",
    "dist:linux": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux deb rpm AppImage pacman --publish never",
    "dist:deb": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux deb --publish never",
    "dist:rpm": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux rpm --publish never",
    "dist:arch": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux pacman --publish never",
    "dist:appimage": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux AppImage --publish never",
    "dist:win": "cross-env ELECTRON_DIST=1 vite build && electron-builder --win --publish never",
    "dist:mac": "cross-env ELECTRON_DIST=1 vite build && electron-builder --mac --universal --publish never",
    "lint": "eslint src index.js preload.js player-preload.js popout-preload.js"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "terser": "^5.46.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.genesiszr.sixfaced",
    "productName": "Sixfaced",
    "asar": true,
    "compression": "normal",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/mac/**",
      "!dist/mac-arm64/**",
      "!dist/mac-universal/**",
      "!dist/mac-universal-x64-temp/**",
      "!dist/mac-universal-arm64-temp/**",
      "!dist/win-unpacked/**",
      "!dist/linux-unpacked/**",
      "!dist/*.dmg",
      "!dist/*.exe",
      "!dist/*.deb",
      "!dist/*.rpm",
      "!dist/*.AppImage",
      "!dist/*.blockmap",
      "!dist/*.yaml",
      "!dist/.icon-icns/**",
      "src/ipc/**/*",
      "index.js",
      "preload.js",
      "popout-preload.js",
      "player-preload.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/.cache/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,changelog.md,CHANGES,LICENCE,LICENSE}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,benchmark,benchmarks}/**",
      "!**/node_modules/.bin/**",
      "!**/node_modules/*/*.d.ts",
      "!**/{.eslintrc,.babelrc,.editorconfig,.nycrc}",
      "!**/{jest.config,jest.config.js,jest.config.ts}",
      "!**/node_modules/*/docs/**",
      "!**/node_modules/vite/**",
      "!**/node_modules/@vitejs/**",
      "!**/node_modules/terser/**",
      "!**/node_modules/rollup/**",
      "!**/node_modules/esbuild/**",
      "!**/node_modules/@esbuild/**",
      "!**/node_modules/@rollup/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createStartMenuShortcut": true,
      "selectPerMachineByDefault": false,
      "license": "LICENSE",
      "uninstallDisplayName": "Uninstall Sixfaced",
      "installerSidebar": "public/installer-sidebar.bmp"
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "public/sized",
      "desktop": {
        "entry": {
          "Name": "Sixfaced",
          "Comment": "Sixfaced Desktop App",
          "Categories": "AudioVideo;Video;Player;Multimedia;Internet;",
          "Icon": "streambert",
          "StartupWMClass": "Sixfaced"
        }
      }
    },
    "rpm": {
      "packageCategory": "Applications/Multimedia",
      "depends": [
        "gtk3",
        "libnotify",
        "libXScrnSaver",
        "nss"
      ]
    },
    "electronLanguages": [
      "en-US",
      "de"
    ]
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  },
  "productName": "Sixfaced",
  "repository": {
    "type": "git",
    "url": "https://github.com/Genesis-Z-R/sixfaced.git"
  },
  "homepage": "https://github.com/Genesis-Z-R/sixfaced"
}
